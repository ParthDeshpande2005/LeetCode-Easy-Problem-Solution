class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        d=[]
        if(len(s)==1):
            return False
        for i in range(len(s)-1):
            if (s[i]=="("):
                if(s[i+1]==")"):
                    d.append(")")
                elif(s[i+1]=="["):
                    d.append(")")
                elif(s[i+1]=="{"):
                    d.append(")")
                elif(s[i+1]=="("):
                    d.append(")")
                else:
                    return False
            elif (s[i]=="["):
                if(s[i+1]=="]"):
                    d.append("]")
                elif(s[i+1]=="("):
                    d.append("]")
                elif(s[i+1]=="{"):
                    d.append("]")
                elif(s[i+1]=="["):
                    d.append("]")
                else:
                    return False
            elif (s[i]=="{"):
                if(s[i+1]=="}"):
                    d.append("}")
                elif(s[i+1]=="["):
                    d.append("}")
                elif(s[i+1]=="("):
                    d.append("}")
                elif(s[i+1]=="{"):
                    d.append("}")
                else:
                    return False
            elif (s[i]==")" or s[i]=="]" or s[i]=="}"):
                if(d==[]):
                    return False
                if(d[-1]==s[i]):
                    d.pop(-1)    
                else:
                    return False
            if(i==len(s)-2):
                if(d==[]):
                    return False
                if(d[0]==s[i+1] and len(d)==1):
                    d.pop(0)
                    return True
                else:
                    return False 
        if(d==[]):
            return True
        else:
            return False